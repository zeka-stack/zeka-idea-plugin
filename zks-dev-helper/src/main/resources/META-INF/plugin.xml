<!-- 插件配置文件。更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- 插件的唯一标识符。应该是完全限定名。在插件版本之间不能更改。 -->
    <id>dev.dong4j.zeka.stack.idea.plugin.helper</id>

    <!-- 公共插件名称应使用标题大小写书写。
         指南：https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Zeka Stack Dev Helper</name>

    <!-- 在插件页面上显示的供应商名称或组织ID。 -->
    <vendor email="dong4j@gmail.com">Zeka Stack</vendor>

    <!-- 产品和插件兼容性要求。
         更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- 插件定义的扩展点。
         更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 配置持久化 -->
        <applicationService serviceImplementation="dev.dong4j.zeka.stack.idea.plugin.settings.state.ZksDevHelperMainState"/>
        <applicationService serviceImplementation="dev.dong4j.zeka.stack.idea.plugin.settings.state.CodeStyleSettingsState"/>
        <applicationService serviceImplementation="dev.dong4j.zeka.stack.idea.plugin.settings.state.MyBatisSettingsState"/>
        <applicationService serviceImplementation="dev.dong4j.zeka.stack.idea.plugin.settings.state.ProxyerSettingsState"/>

        <!-- 设置面板 - 主配置（一级菜单） -->
        <!--suppress PluginXmlI18n -->
        <projectConfigurable
            parentId="other"
            instance="dev.dong4j.zeka.stack.idea.plugin.settings.configurable.ZksDevHelperMainConfigurable"
            id="dev.dong4j.zeka.stack.idea.plugin.settings.configurable.ZksDevHelperMainConfigurable"
            displayName="🙉 ZKS Dev Helper"/>

        <!-- 设置面板 - 代码样式配置（二级菜单） -->
        <!--suppress PluginXmlI18n -->
        <projectConfigurable
            parentId="dev.dong4j.zeka.stack.idea.plugin.settings.configurable.ZksDevHelperMainConfigurable"
            instance="dev.dong4j.zeka.stack.idea.plugin.settings.configurable.CodeStyleSettingsConfigurable"
            id="dev.dong4j.zeka.stack.idea.plugin.settings.configurable.CodeStyleSettingsConfigurable"
            displayName="🎨 Code Style"/>

        <!-- 设置面板 - MyBatis 配置（二级菜单） -->
        <!--suppress PluginXmlI18n -->
        <projectConfigurable
            parentId="dev.dong4j.zeka.stack.idea.plugin.settings.configurable.ZksDevHelperMainConfigurable"
            instance="dev.dong4j.zeka.stack.idea.plugin.settings.configurable.MyBatisSettingsConfigurable"
            id="dev.dong4j.zeka.stack.idea.plugin.settings.configurable.MyBatisSettingsConfigurable"
            displayName="🗄️ MyBatis"/>

        <!-- 设置面板 - Proxyer 配置（二级菜单） -->
        <!--suppress PluginXmlI18n -->
        <projectConfigurable
            parentId="dev.dong4j.zeka.stack.idea.plugin.settings.configurable.ZksDevHelperMainConfigurable"
            instance="dev.dong4j.zeka.stack.idea.plugin.settings.configurable.ProxyerSettingsConfigurable"
            id="dev.dong4j.zeka.stack.idea.plugin.settings.configurable.ProxyerSettingsConfigurable"
            displayName="🔄 Proxyer"/>

        <!-- 通知组 -->
        <notificationGroup id="ZKS Dev Helper Notifications"
                           displayType="BALLOON"
                           isLogByDefault="true"/>

        <!-- Live Template 支持 -->
        <defaultLiveTemplates file="liveTemplates/zeka-stack-live-template.xml"/>
        <liveTemplateContext implementation="dev.dong4j.zeka.stack.idea.plugin.template.live.UniformLiveTemplateContext"
                             contextId="zeka.stack"/>

        <!-- Startup Activities -->
        <postStartupActivity implementation="dev.dong4j.zeka.stack.idea.plugin.codestyle.UniformCodeStyleHandler"/>
        <postStartupActivity implementation="dev.dong4j.zeka.stack.idea.plugin.template.file.UniformFileTemplatesHandler"/>

    </extensions>
</idea-plugin>
