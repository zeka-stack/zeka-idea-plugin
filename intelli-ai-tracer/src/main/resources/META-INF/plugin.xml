<!-- 插件配置文件。更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- 插件的唯一标识符。应该是完全限定名。在插件版本之间不能更改。 -->
    <id>dev.dong4j.zeka.stack.idea.plugin.workflow</id>

    <!-- 公共插件名称应使用标题大小写书写。
         指南：https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>IntelliAI Tracer</name>

    <!-- 在插件页面上显示的供应商名称或组织ID。 -->
    <vendor email="dong4j@gmail.com">dong4j</vendor>

    <!-- 产品和插件兼容性要求。
         更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <idea-version since-build="223" until-build="252.*"/>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <!-- 依赖 IntelliAI Engine 插件 -->
    <depends>dev.dong4j.zeka.stack.idea.plugin.common.ai</depends>
    <!-- 依赖 Mermaid 插件（可选，用于渲染 Mermaid 图表） -->

    <!-- 国际化资源文件 -->
    <resource-bundle>messages.WorkflowBundle</resource-bundle>

    <!-- 插件定义的扩展点。
         更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 通知组 -->
        <!--suppress PluginXmlI18n -->
        <notificationGroup id="IntelliAI Tracer Notifications"
                           displayType="BALLOON"
                           isLogByDefault="true"/>

        <applicationService serviceImplementation="dev.dong4j.zeka.stack.idea.plugin.workflow.settings.SettingsState"/>

        <!--suppress PluginXmlI18n -->
        <applicationConfigurable
                parentId="tools"
                instance="dev.dong4j.zeka.stack.idea.plugin.workflow.settings.TracerSettingsConfigurable"
                id="dev.dong4j.zeka.stack.idea.plugin.workflow.settings"
                displayName="IntelliAI Tracer"/>

        <!-- 工具窗口 -->
        <!--suppress PluginXmlI18n -->
        <toolWindow id="IntelliAI Tracer"
                    factoryClass="dev.dong4j.zeka.stack.idea.plugin.workflow.ui.WorkflowResultToolWindowFactory"
                    anchor="right"
                    icon="icons.TracerIcons.WORKFLOW_ACTION"/>

        <!-- 意图操作 -->
        <intentionAction>
            <language>JAVA</language>
            <className>dev.dong4j.zeka.stack.idea.plugin.workflow.action.ExplainWorkflowIntentionAction</className>
            <category>IntelliAI Tracer</category>
        </intentionAction>
    </extensions>

    <!-- Markdown 扩展（可选，兼容不同版本） -->
    <extensions defaultExtensionNs="org.intellij.markdown">
        <!-- Markdown 预览链接处理器 -->
        <browserPreviewExtensionProvider implementation="dev.dong4j.zeka.stack.idea.plugin.workflow.ui.MarkdownLinkHandler$Provider"/>
    </extensions>

    <!-- 因为有这个 导致报错-->
    <!--<applicationService serviceInterface="org.intellij.plugins.markdown.ui.preview.accessor.MarkdownLinkOpener"-->
    <!--                    serviceImplementation="org.intellij.plugins.markdown.ui.preview.accessor.impl.MarkdownLinkOpenerImpl"/>-->

    <!-- 插件定义的动作 -->
    <actions>
        <!-- 编辑器右键菜单 -->
        <action id="dev.dong4j.zeka.stack.idea.plugin.workflow.action.ExplainWorkflowAction"
                class="dev.dong4j.zeka.stack.idea.plugin.workflow.action.ExplainWorkflowAction"
                text="Explain Workflow with AI"
                description="Analyze method call chain and generate workflow explanation using AI">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>

