<!-- IntelliAI Engine 插件配置文件 -->
<idea-plugin>
    <!-- 插件的唯一标识符 -->
    <id>dev.dong4j.zeka.stack.idea.plugin.common.ai</id>

    <!-- 公共插件名称 -->
    <name>IntelliAI Engine</name>

    <!-- 供应商信息 -->
    <vendor email="dong4j@gmail.com">dong4j</vendor>

    <resource-bundle>messages.AICommonBundle</resource-bundle>

    <!-- 依赖的平台模块 -->
    <depends>com.intellij.modules.platform</depends>

    <applicationListeners>
        <listener class="dev.dong4j.zeka.stack.idea.plugin.common.agent.PluginLifecycleListener"
                  topic="com.intellij.openapi.application.ApplicationActivationListener"/>
    </applicationListeners>

    <!-- 定义扩展点 -->
    <extensionPoints>
        <extensionPoint name="pluginUpdateInfoProvider"
                        interface="dev.dong4j.zeka.stack.idea.plugin.common.update.PluginUpdateInfoProvider"
                        dynamic="true"/>
        <extensionPoint name="whatsNewProvider"
                        interface="dev.dong4j.zeka.stack.idea.plugin.common.whatsnew.WhatsNewProvider"
                        dynamic="true"/>
        <extensionPoint name="statusBarPopupProvider"
                        interface="dev.dong4j.zeka.stack.idea.plugin.common.statusbar.AIStatusBarPopupProvider"
                        dynamic="true"/>
    </extensionPoints>

    <!-- 插件定义的扩展点 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 应用级服务：全局 AI 配置（可用供应商列表） -->
        <applicationService
            serviceImplementation="dev.dong4j.zeka.stack.idea.plugin.common.config.AIProviderSettings"/>

        <!-- 应用级服务：统一的 AI 服务入口 -->
        <applicationService
            serviceInterface="dev.dong4j.zeka.stack.idea.plugin.common.ai.service.AIService"
            serviceImplementation="dev.dong4j.zeka.stack.idea.plugin.common.ai.service.AIServiceImpl"/>

        <applicationService
            serviceInterface="dev.dong4j.zeka.stack.idea.plugin.common.whatsnew.WhatsNewProviderService"
            serviceImplementation="dev.dong4j.zeka.stack.idea.plugin.common.whatsnew.InternalWhatsNewProviderService"/>

        <fileEditorProvider implementation="dev.dong4j.zeka.stack.idea.plugin.common.whatsnew.WhatsNewHtmlEditorProvider"/>

        <!-- 设置页面：IntelliAI Engine 的全局配置（应用级配置） -->
        <!--suppress PluginXmlI18n -->
        <applicationConfigurable
            parentId="other"
            instance="dev.dong4j.zeka.stack.idea.plugin.common.settings.AICommonSettingsConfigurable"
            id="dev.dong4j.zeka.stack.idea.plugin.common.settings.AICommonSettingsConfigurable"
            displayName="🤖 IntelliAI Engine"/>

        <!-- Chat 工具窗口 -->
        <!--suppress PluginXmlI18n -->
        <!--<toolWindow id="IntelliAI Chat"-->
        <!--            factoryClass="dev.dong4j.zeka.stack.idea.plugin.common.chat.AIChatToolWindowFactory"-->
        <!--            anchor="right"-->
        <!--            icon="icons.AICommonIcons.TOOL_ICON"-->
        <!--            doNotActivateOnStart="true"/>-->

        <!-- 项目启动时根据配置自动运行 agent -->
        <postStartupActivity implementation="dev.dong4j.zeka.stack.idea.plugin.common.agent.AgentServerLifecycleListener"/>
        <!-- 项目启动时添加 agent 版本检查任务 -->
        <postStartupActivity implementation="dev.dong4j.zeka.stack.idea.plugin.common.agent.AgentVersionCheckListener"/>
        <!-- 项目启动时检查插件更新 -->
        <postStartupActivity implementation="dev.dong4j.zeka.stack.idea.plugin.common.update.UpdateStartupActivity"/>
        <!-- 项目启动时显示更新日志 -->
        <postStartupActivity implementation="dev.dong4j.zeka.stack.idea.plugin.common.whatsnew.WhatsNewStartupActivity"/>
        <!-- 项目启动时初始化 Console Tab -->
        <postStartupActivity implementation="dev.dong4j.zeka.stack.idea.plugin.common.console.AIConsoleStartupActivity"/>
        <!-- 通知组 -->
        <!--suppress PluginXmlI18n -->
        <notificationGroup id="IntelliAI Engine Notifications"
                           displayType="BALLOON"
                           isLogByDefault="true"/>

        <!-- 状态栏聚合入口 -->
        <statusBarWidgetFactory implementation="dev.dong4j.zeka.stack.idea.plugin.common.statusbar.AIStatusBarWidgetFactory"
                                order="first" id="dev.dong4j.zeka.stack.idea.plugin.common.statusbar.AIStatusBarWidget"/>

    </extensions>

    <extensions defaultExtensionNs="dev.dong4j.zeka.stack.idea.plugin.common.ai">
        <whatsNewProvider
            implementation="dev.dong4j.zeka.stack.idea.plugin.common.whatsnew.InternalWhatsNewProvider"/>
    </extensions>

    <actions>
        <action id="IntelliAIEngine.WhatsNewAction"
                class="dev.dong4j.zeka.stack.idea.plugin.common.whatsnew.WhatsNewAction">
            <add-to-group group-id="HelpMenu" anchor="last"/>
        </action>

    </actions>
</idea-plugin>
