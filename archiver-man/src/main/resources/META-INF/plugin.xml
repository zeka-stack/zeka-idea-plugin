<!-- 插件配置文件。更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- 插件的唯一标识符。应该是完全限定名。在插件版本之间不能更改。 -->
    <id>dev.dong4j.zeka.stack.idea.plugin.archiver.man</id>

    <!-- 公共插件名称应使用标题大小写书写。
         指南：https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Archiver Man</name>

    <!-- 在插件页面上显示的供应商名称或组织ID。 -->
    <vendor email="dong4j@gmail.com">dong4j</vendor>

    <!-- 产品和插件兼容性要求。
         更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <idea-version since-build="223" until-build="999.*"/>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- 国际化资源文件 -->
    <resource-bundle>messages.ArchiverBundle</resource-bundle>

    <!-- 插件定义的扩展点。
         更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

        <applicationConfigurable
                parentId="tools"
                instance="dev.dong4j.zeka.stack.idea.plugin.archiver.settings.ArchiverSettingsConfigurable"
                id="dev.dong4j.zeka.stack.idea.plugin.archiver.settings"
                displayName="Archiver Man"/>
        <!-- 通知组 -->
        <!--suppress PluginXmlI18n -->
        <notificationGroup id="Archiver Man Notifications"
                           displayType="BALLOON"
                           isLogByDefault="true"/>
        <treeStructureProvider implementation="dev.dong4j.zeka.stack.idea.plugin.archiver.projectview.ArchiveTreeStructureProvider"/>
    </extensions>

    <applicationListeners>
        <listener class="dev.dong4j.zeka.stack.idea.plugin.archiver.listener.EditableArchiveDocumentListener"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>

    <!-- 插件定义的动作 -->
    <actions>
        <!-- 编辑器右键菜单 -->
        <action id="dev.dong4j.zeka.stack.idea.plugin.archiver.action.ArchiveContextAction"
                class="dev.dong4j.zeka.stack.idea.plugin.archiver.action.ArchiveContextAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <!-- 强制保存归档内容 -->
        <action id="dev.dong4j.zeka.stack.idea.plugin.archiver.action.ForceSaveArchiveAction"
                class="dev.dong4j.zeka.stack.idea.plugin.archiver.action.ForceSaveArchiveAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>

