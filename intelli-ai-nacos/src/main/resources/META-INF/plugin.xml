<!-- 插件配置文件。更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- 插件的唯一标识符。应该是完全限定名。在插件版本之间不能更改。 -->
    <id>dev.dong4j.zeka.stack.idea.plugin.nacos</id>

    <!-- 公共插件名称应使用标题大小写书写。
         指南：https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>IntelliAI Nacos</name>

    <!-- 在插件页面上显示的供应商名称或组织ID。 -->
    <vendor email="dong4j@gmail.com">dong4j</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <!-- 依赖 IntelliAI Engine 插件 -->
    <depends>dev.dong4j.zeka.stack.idea.plugin.common.ai</depends>

    <resource-bundle>messages.NacosBundle</resource-bundle>

    <!-- 插件定义的扩展点。
         更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 配置持久化 -->
        <applicationService serviceImplementation="dev.dong4j.zeka.stack.idea.plugin.nacos.settings.SettingsState"/>

        <!-- 设置面板 -->
        <!--suppress PluginXmlI18n -->
        <applicationConfigurable
            parentId="dev.dong4j.zeka.stack.idea.plugin.common.settings.AICommonSettingsConfigurable"
                instance="dev.dong4j.zeka.stack.idea.plugin.nacos.settings.NacosSettingsConfigurable"
                id="dev.dong4j.zeka.stack.idea.plugin.nacos.settings.NacosSettingsConfigurable"
            displayName="🧑‍💻 IntelliAI Nacos"/>

        <!-- 通知组 -->
        <!--suppress PluginXmlI18n -->
        <notificationGroup id="IntelliAI Nacos Notifications"
                           displayType="BALLOON"
                           isLogByDefault="true"/>

        <!-- 启动活动：注册本地 Nacos 生命周期监听器 -->
        <postStartupActivity implementation="dev.dong4j.zeka.stack.idea.plugin.nacos.local.LocalNacosAppLifecycleListener"/>

        <!-- 工具窗口 -->
        <toolWindow factoryClass="dev.dong4j.zeka.stack.idea.plugin.nacos.ui.toolwindow.NacosToolWindowFactory"
                    id="Nacos"
                    anchor="bottom"
                    icon="icons.NacosIcons.NACOS_16"/>

        <!-- 意图操作 -->
        <intentionAction>
            <language/>
            <className>dev.dong4j.zeka.stack.idea.plugin.nacos.action.PublishConfigIntentionAction</className>
            <!--<category>IntelliAI Nacos</category>-->
            <descriptionDirectoryName>PublishConfigIntention</descriptionDirectoryName>
        </intentionAction>

        <intentionAction>
            <language/>
            <className>dev.dong4j.zeka.stack.idea.plugin.nacos.action.CompareConfigIntentionAction</className>
            <!--<category>IntelliAI Nacos</category>-->
            <descriptionDirectoryName>CompareConfigIntention</descriptionDirectoryName>
        </intentionAction>
    </extensions>

    <extensions defaultExtensionNs="dev.dong4j.zeka.stack.idea.plugin.common.ai">
        <feedbackContextProvider implementation="dev.dong4j.zeka.stack.idea.plugin.nacos.diagnostic.NacosFeedbackContextProvider"/>
        <pluginUpdateInfoProvider implementation="dev.dong4j.zeka.stack.idea.plugin.nacos.update.NacosPluginUpdateInfoProvider"/>
    </extensions>

    <!-- 插件定义的动作 -->
    <actions>
        <action id="dev.dong4j.zeka.stack.idea.plugin.nacos.PublishConfigByMenuAction"
                class="dev.dong4j.zeka.stack.idea.plugin.nacos.action.PublishConfigByMenuAction"
                text="发布到 Nacos"
                description="将所选配置文件发布到 Nacos">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
