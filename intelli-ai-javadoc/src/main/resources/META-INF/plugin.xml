<!-- 插件配置文件。更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- 插件的唯一标识符。应该是完全限定名。在插件版本之间不能更改。 -->
    <id>dev.dong4j.zeka.stack.idea.plugin</id>

    <!-- 公共插件名称应使用标题大小写书写。
         指南：https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>IntelliAI Javadoc</name>

    <!-- 在插件页面上显示的供应商名称或组织ID。 -->
    <vendor email="dong4j@gmail.com">dong4j</vendor>

    <!-- 依赖的平台模块 -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>org.jetbrains.idea.maven</depends>
    <!-- 依赖 IntelliAI Engine 插件 -->
    <depends>dev.dong4j.zeka.stack.idea.plugin.common.ai</depends>
    <resource-bundle>messages.AIJBundle</resource-bundle>

    <!-- 插件定义的扩展点。
         更多信息：https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 配置持久化 -->
        <applicationService serviceImplementation="dev.dong4j.zeka.stack.idea.javadoc.settings.SettingsState"/>

        <!-- 设置面板 -->
        <!--suppress PluginXmlI18n -->
        <applicationConfigurable
            parentId="dev.dong4j.zeka.stack.idea.plugin.common.settings.AICommonSettingsConfigurable"
            instance="dev.dong4j.zeka.stack.idea.javadoc.settings.JavadocSettingsConfigurable"
            id="dev.dong4j.zeka.stack.idea.javadoc.settings.JavadocSettingsConfigurable"
            displayName="🙉 IntelliAI Javadoc"/>

        <!-- 通知组 dev.dong4j.zeka.stack.idea.util.javadoc.NotificationUtil.NOTIFICATION_GROUP_ID 保持一致 -->
        <!--suppress PluginXmlI18n -->
        <notificationGroup id="IntelliAI Javadoc Notifications"
                           displayType="BALLOON"
                           isLogByDefault="true"/>

        <!-- Commit 检查 -->
        <checkinHandlerFactory implementation="dev.dong4j.zeka.stack.idea.javadoc.git.CommitJavadocCheckinHandlerFactory"/>

        <!-- 自动注册自定义 Javadoc 标签 -->
        <postStartupActivity implementation="dev.dong4j.zeka.stack.idea.javadoc.component.CustomJavadocTagRegistrar"/>

        <!-- Maven 缓存清理监听器（在启动活动中注册） -->
        <postStartupActivity implementation="dev.dong4j.zeka.stack.idea.javadoc.component.ProjectVersionCacheCleanupListener"/>

        <!-- Javadoc 文件模板处理器 -->
        <postStartupActivity implementation="dev.dong4j.zeka.stack.idea.javadoc.component.JavadocFileTemplatesHandler"/>

        <!-- 文件保存时自动生成 Javadoc 监听器 -->
        <!--<applicationService serviceImplementation="dev.dong4j.zeka.stack.idea.javadoc.listener.GenerateOnSaveListener"/>-->


        <!-- 状态栏快捷设置改为由 engine 聚合 -->

        <!-- Intention Action (Option+Enter / Alt+Enter 快捷菜单) -->
        <intentionAction>
            <language/>
            <className>dev.dong4j.zeka.stack.idea.javadoc.action.GenerateJavadocIntentionAction</className>
            <!--<category>IntelliAI Javadoc</category>-->
            <descriptionDirectoryName>GenerateJavaDocIntention</descriptionDirectoryName>
        </intentionAction>

        <!-- Code Vision Provider (代码上方显示"Generate Javadoc"链接) -->
        <!--suppress PluginXmlValidity -->
        <codeInsight.codeVisionProvider implementation="dev.dong4j.zeka.stack.idea.javadoc.codevision.GenerateJavadocCodeVisionProvider"/>

        <!-- Code Vision Provider (代码上方显示"Delete Javadoc"链接) -->
        <!--suppress PluginXmlValidity -->
        <codeInsight.codeVisionProvider implementation="dev.dong4j.zeka.stack.idea.javadoc.codevision.DeleteJavadocCodeVisionProvider"/>

        <!-- Intention Action (Option+Enter / Alt+Enter 快捷菜单 - 删除 Javadoc) -->
        <intentionAction>
            <language/>
            <className>dev.dong4j.zeka.stack.idea.javadoc.action.DeleteJavadocIntentionAction</className>
            <descriptionDirectoryName>DeleteJavaDocIntention</descriptionDirectoryName>
        </intentionAction>

    </extensions>

    <applicationListeners>
        <listener
            topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"
            class="dev.dong4j.zeka.stack.idea.javadoc.listener.GenerateOnSaveListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="dev.dong4j.zeka.stack.idea.plugin.common.ai">
        <feedbackContextProvider implementation="dev.dong4j.zeka.stack.idea.javadoc.diagnostic.JavadocFeedbackContextProvider"/>
        <pluginUpdateInfoProvider implementation="dev.dong4j.zeka.stack.idea.javadoc.update.JavadocPluginUpdateInfoProvider"/>
        <statusBarPopupProvider implementation="dev.dong4j.zeka.stack.idea.javadoc.statusbar.AIJavadocStatusBarPopupProvider"/>
    </extensions>

    <!-- 插件定义的动作 -->
    <actions>
        <!-- Git 提交工具栏操作 -->
        <!-- 使用 Vcs.MessageActionGroup 添加到提交消息区域 -->
        <action id="dev.dong4j.zeka.stack.idea.javadoc.action.GenerateJavadocForCommitAction"
                class="dev.dong4j.zeka.stack.idea.javadoc.action.GenerateJavadocForCommitAction"
                icon="/icons/aij_16.svg"
                text="Generate Javadoc For Commit">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="last"/>
        </action>
        <!-- 快捷键入口 (Ctrl+Shift+D / Cmd+Shift+D) -->
        <!--suppress PluginXmlI18n -->
        <action id="dev.dong4j.zeka.stack.idea.javadoc.action.GenerateJavadocShortcutAction"
                class="dev.dong4j.zeka.stack.idea.javadoc.action.GenerateJavadocShortcutAction"
                text="Generate Javadoc with AI"
                description="Generate Javadoc using AI">
            <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl D"/>
        </action>

        <!-- 编辑器右键菜单 -->
        <action id="dev.dong4j.zeka.stack.idea.javadoc.action.GenerateJavadocForEditorAction"
                class="dev.dong4j.zeka.stack.idea.javadoc.action.GenerateJavadocForEditorAction"
                icon="/icons/aij_16.svg"
                text="Generate Javadoc For Editor">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <!-- 编辑器右键菜单 - 删除 Javadoc -->
        <action id="dev.dong4j.zeka.stack.idea.javadoc.action.DeleteJavadocForEditorAction"
                class="dev.dong4j.zeka.stack.idea.javadoc.action.DeleteJavadocForEditorAction"
                icon="/icons/aij_16.svg"
                text="Delete Javadoc For Editor">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <!-- 项目视图右键菜单 -->
        <action id="dev.dong4j.zeka.stack.idea.javadoc.action.GenerateJavadocForFilesAction"
                class="dev.dong4j.zeka.stack.idea.javadoc.action.GenerateJavadocForFilesAction"
                icon="/icons/aij_16.svg"
                text="Generate Javadoc For Files">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewToolbar" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <!-- 项目视图右键菜单 - 删除 Javadoc -->
        <action id="dev.dong4j.zeka.stack.idea.javadoc.action.DeleteJavadocForFilesAction"
                class="dev.dong4j.zeka.stack.idea.javadoc.action.DeleteJavadocForFilesAction"
                icon="/icons/aij_16.svg"
                text="Delete Javadoc For Files">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- Generate 菜单 (Command+N / Alt+Insert) -->
        <action id="dev.dong4j.zeka.stack.idea.javadoc.action.GenerateJavadocGenerateAction"
                class="dev.dong4j.zeka.stack.idea.javadoc.action.GenerateJavadocGenerateAction"
                icon="/icons/aij_16.svg"
                text="Generate Javadoc">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
